[Unit]
Description=Canopee relay node
After=network.target

[Service]
Type=simple
User=canopee
Environment=CANOPEE_LISTEN_PORT=4001
# The relay doubles as the public publishing edge (enabled by default):
# browsers reach published apps on CANOPEE_EDGE_HTTP_PORT, tunneled to the
# publisher over libp2p. Uncomment to customize, or set CANOPEE_EDGE=0 to
# run as a pure relay.
#Environment=CANOPEE_EDGE_HTTP_PORT=8080
# Terminate HTTPS on the edge itself (wildcard cert for *.<base-domain>):
#Environment=CANOPEE_EDGE_HTTP_PORT=443
#ReadWritePaths=/etc/canopee-edge
#Environment=CANOPEE_EDGE_TLS_CERT=/etc/canopee-edge/fullchain.pem
#Environment=CANOPEE_EDGE_TLS_KEY=/etc/canopee-edge/privkey.pem
ExecStart=/home/canopee/canopee/target/release/canopee-node
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
